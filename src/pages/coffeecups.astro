---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";

const {
  title = "Coffee Cups",
  description = "Celebrating the art of coffee cups",
} = Astro.props;
---

<BaseLayout title={title} description={description} width="medium">
  <h1>Coffee Cups</h1>
  <p>A celebration of the art of coffee cups.</p>

  <h2>
    <a href="https://www.instagram.com/chen.andcoffee/">CHEN&coffee</a> @ <a
      href="https://unboundsf.co/en">Unbound Bookstore</a
    > (2026-04-25)
  </h2>
  <div>
    <Image
      src={import(`../assets/coffeecups/chen-and-coffee.jpg`)}
      alt={"Front side of a coffee cup from Chen & Coffee, with a small cartoon face"}
      title={"Front side of a coffee cup from Chen & Coffee, with a small cartoon face"}
      format="webp"
      widths={[400, 800, 1200, 1920]}
      sizes="(min-width: 768px) calc(50vw - 1rem), 100vw"
    />
  </div>

  <h2><a href="https://www.elaichico.com/">elaichi co.</a></h2>
  <div>
    <Image
      src={import(`../assets/coffeecups/elaichi-chai-1.jpg`)}
      alt={"Front side of a coffee cup from elaichi co, featuring a cardamom pod (?)"}
      title={"Front side of a coffee cup from elaichi co, featuring a cardamom pod (?)"}
      format="webp"
      widths={[400, 800, 1200, 1920]}
      sizes="(min-width: 768px) calc(50vw - 1rem), 100vw"
    />

    <Image
      src={import(`../assets/coffeecups/elaichi-chai-2.jpg`)}
      alt={"Back side of a coffee cup from elaichi co, featuring the company name"}
      title={"Back side of a coffee cup from elaichi co, featuring the company name"}
      format="webp"
      widths={[400, 800, 1200, 1920]}
      sizes="(min-width: 768px) calc(50vw - 1rem), 100vw"
    />
  </div>

  <h2><a href="https://www.urbanritualcafe.com/">Urban Ritual</a></h2>
  <div>
    <Image
      src={import(`../assets/coffeecups/urban-ritual-1.jpg`)}
      alt={"Front side of a tea cup from Urban Ritual, featuring a stylized teapot"}
      title={"Front side of a tea cup from Urban Ritual, featuring a stylized teapot"}
      format="webp"
      widths={[400, 800, 1200, 1920]}
      sizes="(min-width: 768px) calc(50vw - 1rem), 100vw"
    />

    <Image
      src={import(`../assets/coffeecups/urban-ritual-2.jpg`)}
      alt={"Back side of a tea cup from Urban Ritual, featuring stylized tea leaves and honey spoons"}
      title={"Back side of a tea cup from Urban Ritual, featuring stylized tea leaves and honey spoons"}
      format="webp"
      widths={[400, 800, 1200, 1920]}
      sizes="(min-width: 768px) calc(50vw - 1rem), 100vw"
    />
  </div>

  <h2><a href="https://ashateahouse.com/">Asha Tea House</a></h2>
  <div>
    <Image
      src={import(`../assets/coffeecups/asha.jpg`)}
      alt={"Front side of a tea cup from Asha Tea House, showing their label and stylized tea leaves"}
      title={"Front side of a tea cup from Asha Tea House, showing their label and stylized tea leaves"}
      format="webp"
      widths={[400, 800, 1200, 1920]}
      sizes="(min-width: 768px) calc(50vw - 1rem), 100vw"
    />
  </div>

  <h2>
    <a href="https://www.instagram.com/falling.goose/">Falling Goose</a> @ <a
      href="https://papersoncoffee.com/">Paper Son Coffee</a> (4/3/26)
  </h2>
  <div>
    <Image
      src={import(`../assets/coffeecups/falling_goose.jpg`)}
      alt={"Front side of a coffee cup from Falling Goose, showing their label and falling goose icon"}
      title={"Front side of a coffee cup from Falling Goose, showing their label and falling goose icon"}
      format="webp"
      widths={[400, 800, 1200, 1920]}
      sizes="(min-width: 768px) calc(50vw - 1rem), 100vw"
    />
  </div>

  <h2>
    <a href="https://www.thecoffeemovement.com/">The Coffee Movement</a>
  </h2>
  <div>
    <Image
      src={import(`../assets/coffeecups/coffee_movement.jpg`)}
      alt={"Front side of a coffee cup from Coffee Movement, showing their label"}
      title={"Front side of a coffee cup from Coffee Movement, showing their label"}
      format="webp"
      widths={[400, 800, 1200, 1920]}
      sizes="(min-width: 768px) calc(50vw - 1rem), 100vw"
    />
  </div>

  <h2><a href="https://papersoncoffee.com/">Paper Son Coffee</a></h2>
  <div>
    <Image
      src={import(`../assets/coffeecups/paper_son-1.jpg`)}
      alt={"Front side of a coffee cup from Paper Son, showing their label and their stylized bear character"}
      title={"Front side of a coffee cup from Paper Son, showing their label and their stylized bear character"}
      format="webp"
      widths={[400, 800, 1200, 1920]}
      sizes="(min-width: 768px) calc(50vw - 1rem), 100vw"
    />

    <Image
      src={import(`../assets/coffeecups/paper_son-2.jpg`)}
      alt={"Back side of a coffee cup from Paper Son, showing their label and their stylized bear character"}
      title={"Back side of a coffee cup from Paper Son, showing their label and their stylized bear character"}
      format="webp"
      widths={[400, 800, 1200, 1920]}
      sizes="(min-width: 768px) calc(50vw - 1rem), 100vw"
    />
  </div>

  <h2>
    <a href="https://www.sprocoffeelab.com/">SPRO</a>
  </h2>
  <div>
    <Image
      src={import(`../assets/coffeecups/spro.jpg`)}
      alt={"Front side of a coffee cup from SPRO, showing their label"}
      title={"Front side of a coffee cup from SPRO, showing their label"}
      format="webp"
      widths={[400, 800, 1200, 1920]}
      sizes="(min-width: 768px) calc(50vw - 1rem), 100vw"
    />
  </div>

  <h2><a href="https://www.beanekacoffee.com/pages/our-location">Kopiku Coffee</a></h2>
  <div>
    <Image
      src={import(`../assets/coffeecups/kopiku-1.jpg`)}
      alt={"Front side of a coffee cup from Kopiku Coffee, showing their label"}
      title={"Front side of a coffee cup from Kopiku Coffee, showing their label"}
      format="webp"
      widths={[400, 800, 1200, 1920]}
      sizes="(min-width: 768px) calc(50vw - 1rem), 100vw"
    />

    <Image
      src={import(`../assets/coffeecups/kopiku-2.jpg`)}
      alt={"Back side of a coffee cup from Kopiku Coffee, showing a thank you message"}
      title={"Back side of a coffee cup from Kopiku Coffee, showing a thank you message"}
      format="webp"
      widths={[400, 800, 1200, 1920]}
      sizes="(min-width: 768px) calc(50vw - 1rem), 100vw"
    />
  </div>

  <h2>
    <a href="https://www.saintfrankcoffee.com/">Saint Frank Coffee</a>
  </h2>
  <div>
    <Image
      src={import(`../assets/coffeecups/saintfrank.jpg`)}
      alt={"Front side of a coffee cup from Saint Frank Coffee, showing their stylized-F label"}
      title={"Front side of a coffee cup from Saint Frank Coffee, showing their stylized-F label"}
      format="webp"
      widths={[400, 800, 1200, 1920]}
      sizes="(min-width: 768px) calc(50vw - 1rem), 100vw"
    />
  </div>

  <h2>
    <a href="https://www.rafaelskitchen.com/">Rafael's Kitchen & Mad Coffee (Santa Ana)</a>
  </h2>
  <div>
    <Image
      src={import(`../assets/coffeecups/mad-coffee.jpg`)}
      alt={"Front side of a coffee cup from Mad Coffee, showing their label"}
      title={"Front side of a coffee cup from Mad Coffee, showing their label"}
      format="webp"
      widths={[400, 800, 1200, 1920]}
      sizes="(min-width: 768px) calc(50vw - 1rem), 100vw"
    />
  </div>
</BaseLayout>

<style>
  div {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    grid-template-rows: none;
  }

  @media (min-width: 768px) {
    div:has(> :nth-child(2)) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    div:not(:has(> :nth-child(2))) img {
      max-width: 50%;
    }
  }
</style>
